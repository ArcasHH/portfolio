---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Navigation">
  <Nav />
  
  <div class="text-center mt-20">

    <h1 class="text-8xl font-bold bg-gradient-to-t from-brand-white to-brand-light bg-clip-text text-transparent">
      ArcasHH
    </h1>

    <p class="text-xl text-secondary mt-4"> 
	Game Developer & Artist 
    </p>
    
    <div class="mt-16 flex flex-col sm:flex-row gap-6 justify-center">

      <a href={`${base}dev`} class="bg-brand-light hover:bg-brand-dark text-white px-8 py-4 rounded-xl text-lg font-semibold transition-all shadow-lg hover:shadow-xl">
        Games
      </a>

      <a href={`${base}art`} class="bg-brand-light hover:bg-brand-dark text-white px-8 py-4 rounded-xl text-lg font-semibold transition-all shadow-lg hover:shadow-xl">
        ArtWorks
      </a>

      <a href={`${base}dev`} class="bg-brand-light hover:bg-brand-dark text-white px-8 py-4 rounded-xl text-lg font-semibold transition-all shadow-lg hover:shadow-xl">
        About me
      </a>	

    </div>

    <div class="mt-12 flex flex-wrap gap-4 justify-center">
      <p class="mt-8 text-secondary text-sm">
        Contact me: asyaludv@mail.ru
      </p>
    </div>
  </div>
</BaseLayout>