---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';

const artworks = [
  { title: 'Девачка', category: 'Концепт', src: 'public/images/girl.png' },
  { title: 'Единорог', category: 'Персонаж', src: 'public/images/unicorn.jpg' },
];
---

<BaseLayout title="Artworks">
  <Nav />
  
  <div class="mt-6">
    <h1 class="text-3xl font-bold mb-2">🎨 Художественные работы</h1>
    <p class="text-gray-600 mb-12">Концепты, окружение, пиксель-арт</p>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {artworks.map(art => (
        <div class="group cursor-pointer">
          <div class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all">
            <img src={art.src} alt={art.title} class="w-full h-64 object-cover group-hover:scale-105 transition-transform" />
            <div class="p-4">
              <span class="text-xs text-indigo-600 font-semibold">{art.category}</span>
              <h3 class="font-semibold text-lg mt-1">{art.title}</h3>
            </div>
          </div>
        </div>
      ))}
    </div>
    
  </div>
</BaseLayout>