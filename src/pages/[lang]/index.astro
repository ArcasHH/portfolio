---
// src/pages/[lang]/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={t('hero.title', currentLang)}>
  <div class="text-center mt-20">

    <h1 class="text-8xl md:text-9xl font-bold text-brand-white">
      {t('hero.title', currentLang)}
    </h1>

    <p class="text-2xl md:text-4xl text-primary mt-4"> 
      {t('hero.subtitle', currentLang)}
    </p>
    
    <div class="mt-16 flex flex-col sm:flex-row gap-6 justify-center">
      <a href={`${base}${currentLang}/dev`} class="bg-brand-dark hover:bg-brand-dark text-brand-white px-12 py-6 md:px-16 md:py-8 rounded-xl text-xl md:text-2xl font-semibold transition-all shadow-lg hover:shadow-xl">
        {t('hero.games', currentLang)}
      </a>

      <a href={`${base}${currentLang}/art`} class="bg-brand-dark hover:bg-brand-dark text-brand-white px-12 py-6 md:px-16 md:py-8 rounded-xl text-xl md:text-2xl font-semibold transition-all shadow-lg hover:shadow-xl">
        {t('hero.artworks', currentLang)}
      </a>

      <a href={`${base}${currentLang}/about`} class="bg-brand-dark hover:bg-brand-dark text-brand-white px-12 py-6 md:px-16 md:py-8 rounded-xl text-xl md:text-2xl font-semibold transition-all shadow-lg hover:shadow-xl">
        {t('hero.about', currentLang)}
      </a>	
    </div>

    <div class="mt-12">
      <p class="text-xl md:text-2xl text-primary">
        {t('hero.contact', currentLang)}
      </p>
    </div>
  </div>
</BaseLayout>