---
// src/pages/[lang]/blog/[slug].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { posts } from '../../../data/posts';
import { Icon } from 'astro-icon/components';
import ProjectLinks from '../../../components/ProjectLinks.astro';

export function getStaticPaths() {
  const languages = ['ru', 'en'];
  const paths = [];

  for (const lang of languages) {
    for (const post of posts) {
      paths.push({
        params: { lang, slug: post.slug }
      });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params;
const base = import.meta.env.BASE_URL;

const post = posts.find(p => p.slug === slug);

if (!post) {
  return Astro.redirect(`${base}${lang}/404`);
}

const title = lang === 'ru' ? post.titleRu : post.title;
const description = lang === 'ru' ? post.descriptionRu : post.description;
const content = lang === 'ru' ? post.contentRu : post.content;
---

<BaseLayout title={title}>
  <div class="max-w-4xl mx-auto mt-4">
    <!-- Кнопка назад -->
    <a href={`${base}${lang}/dev`} class="inline-flex items-center gap-2 text-2xl text-primary hover:text-primary/80 mb-6">
      <Icon name="mdi:arrow-left" class="w-5 h-5" />
      {lang === 'ru' ? 'Назад к проектам' : 'Back to projects'}
    </a>

    <!-- Заголовок -->
    <h1 class="text-4xl md:text-6xl font-bold text-brand-white mb-8">
      {title}
    </h1>

    <!-- Дата -->
    <time class="text-brand-white/60 text-lg mb-8 block">
      {post.date}
    </time>

    <!-- Изображение -->
    {post.image && (
      <img src={post.image} alt={title} class="rounded-2xl w-full mb-8" />
    )}

    <!-- Описание -->
    <p class="text-2xl text-primary mb-8">
      {description}
    </p>

    

    <!-- Галерея скриншотов -->
    {post.screenshots && post.screenshots.length > 0 && (
      <div class="mb-12">
        <h2 class="text-3xl font-bold text-brand-white mb-4">
          {lang === 'ru' ? 'Скриншоты' : 'Screenshots'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {post.screenshots.map((screenshot, index) => (
            <img 
              key={index}
              src={screenshot} 
              alt={`${title} screenshot ${index + 1}`}
              class="rounded-xl w-full hover:scale-105 transition-transform cursor-pointer"
            />
          ))}
        </div>
      </div>
    )}

    <!-- Ссылки на игру (GitHub, Itch, MyIndie) -->
    <ProjectLinks slug={post.projectSlug} direction="row" showBlog={false} />

    <!-- Полный контент -->
    <div class="blog-content prose prose-invert prose-lg max-w-none" set:html={content}>
    </div>

    <!-- Кнопка назад -->
    <a href={`${base}${lang}/dev`} class="inline-flex items-center gap-2 text-2xl text-primary hover:text-primary/80 mb-8 mt-8">
      <Icon name="mdi:arrow-left" class="w-5 h-5" />
      {lang === 'ru' ? 'Назад к проектам' : 'Back to projects'}
    </a>

  </div>
</BaseLayout>