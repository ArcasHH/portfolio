---
// src/pages/[lang]/about.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={t('about.title', currentLang)}>
  <div class="max-w-3xl mx-auto mt-12 px-4">

    <h1 class="text-5xl md:text-6xl font-bold mb-8 text-center text-brand-white">
      {currentLang === 'ru' ? 'Обо мне' : 'About me'}
    </h1>

    <div class="space-y-6 text-brand-white/90 text-lg leading-relaxed">
      
      {currentLang === 'ru' ? (
        <>
          <p>
            Меня зовут Анастасия. Я — разработчик игр с навыками:
          </p>

            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <Icon name="mdi:controller" class="w-6 h-6 text-primary" />
                <span>Геймдизайн (механики, баланс, прототипирование)</span>
              </div>
              <div class="flex items-center gap-3">
                <Icon name="mdi:cog" class="w-6 h-6 text-primary" />
                <span>Программирование (Unity, Godot, C#, шейдеры)</span>
              </div>
              <div class="flex items-center gap-3">
                <Icon name="mdi:palette" class="w-6 h-6 text-primary" />
                <span>2D-арт и технический арт</span>
              </div>
            </div>

          <p>
            Сейчас работаю над мобильным платформером как художник окружения + технический арт. Также активно участвую в геймджемах (соло и нет)
          </p>

          <p>
            Ищу позицию в геймдизайне, левел дизайне, техническом дизайне, техническом арте.
          </p>

          <div class="mt-8 pt-4 border-t border-brand-light">
            <p><strong>Связаться:</strong></p>
            <p>Telegram: <a href="https://t.me/arcashh" class="text-primary hover:underline" target="_blank">@arcashh</a></p>
            <p>Почта: <a href="mailto:asyaludv@mail.ru" class="text-primary hover:underline">asyaludv@mail.ru</a></p>
          </div>

          <p style="color: var(--color-brand-light);">
            Портфолио: смотрите проекты на сайте.<br />
            Развёрнутое резюме — по запросу.
          </p>
        </>
      ) : (
        <>
          <p>
            My name is Anastasia. I am a game developer with a combination of skills:
          </p>

            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <Icon name="mdi:controller" class="w-6 h-6 text-primary" />
                <span>Game Design (mechanics, balance, prototyping)</span>
              </div>
              <div class="flex items-center gap-3">
                <Icon name="mdi:cog" class="w-6 h-6 text-primary" />
                <span>Programming (Unity, Godot, C#, shaders)</span>
              </div>
              <div class="flex items-center gap-3">
                <Icon name="mdi:palette" class="w-6 h-6 text-primary" />
                <span>2D Art and Technical Art</span>
              </div>
            </div>

          <p>
            Currently working on a mobile platformer as an environment artist + technical art. I also actively participate in game jams (solo and not)
          </p>

          <p>
            Looking for a position in Game Design, Level Design, Technical Design, Technical Art.
          </p>

          <div class="mt-8 pt-4 border-t border-brand-light">
            <p><strong>Contact me:</strong></p>
            <p>Telegram: <a href="https://t.me/arcashh" class="text-primary hover:underline" target="_blank">@arcashh</a></p>
            <p>Email: <a href="mailto:asyaludv@mail.ru" class="text-primary hover:underline">asyaludv@mail.ru</a></p>
          </div>

          <p style="color: var(--color-brand-light);">
            Portfolio: check out the projects on this site.<br />
            Detailed resume — available upon request.
          </p>
        </>
      )}

    </div>
  </div>
</BaseLayout>