---
// src/pages/[lang]/about.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;
---

