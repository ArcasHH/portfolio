---
// src/pages/[lang]/art.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { artworks } from '../../data/artworks';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;

// Собираем уникальные теги из всех работ
const allTags = [...new Set(artworks.flatMap(art => art.tags))];

const getArtworkData = (art: typeof artworks[0]) => {
  const title = currentLang === 'en' ? art.titleEn : art.titleRu;
  const description = currentLang === 'en' ? art.descriptionEn : art.descriptionRu;
  return { title, description };
};
---

<BaseLayout title={t('art.title', currentLang)}>
  <div class="mt-6">

    <h1 class="text-4xl md:text-5xl font-bold mb-2 text-brand-white">
      {t('art.title', currentLang)}
    </h1>

    <p class="text-primary mb-8 text-2xl">
      {t('art.subtitle', currentLang)}
    </p>
    
    <!-- Социальные ссылки -->
    <div class="flex flex-wrap justify-center gap-4 mb-12">

      <a href="https://www.artstation.com/arcashh" target="_blank" rel="noopener noreferrer" 
         class="bg-brand-dark hover:bg-primary text-brand-white px-6 py-3 rounded-xl transition-all flex items-center gap-2">
        <Icon name="simple-icons:artstation" class="w-6 h-6" />
        ArtStation
      </a>
  
      <a href="https://www.behance.net/arcashh" target="_blank" rel="noopener noreferrer" 
         class="bg-brand-dark hover:bg-primary text-brand-white px-6 py-3 rounded-xl transition-all flex items-center gap-2">
        <Icon name="mdi:behance" class="w-6 h-6" />
        Behance
      </a>
  
    </div>


    <!-- Фильтр категорий -->
    <div class="mb-10">
      <p class="text-brand-white text-xl md:text-2xl font-semibold mb-3">
        {currentLang === 'ru' ? 'Категории:' : 'Categories:'}
      </p>
      <div class="flex flex-wrap gap-3" id="filter-tags">
        <button 
          id="filter-all"
          class="filter-btn px-5 py-2 rounded-full bg-primary text-brand-white text-lg md:text-xl transition-all"
          data-tag="all"
        >
          {currentLang === 'ru' ? 'Все' : 'All'}
        </button>
        {allTags.map(tag => (
          <button 
            key={tag}
            class="filter-btn px-5 py-2 rounded-full bg-brand-light hover:bg-primary text-brand-white text-lg md:text-xl transition-all"
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Контейнер работ -->
    <div id="artworks-container" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {artworks.map(art => {
 	 const { title, description } = getArtworkData(art);
	  return (
	    <a 
 	     href={`${base}${currentLang}/artblog/${art.slug}`}
	      class="artwork-card group block" 
	      data-tags={art.tags.join(',')}
	    >
	      <div class="bg-brand-dark rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all">

              <div class="aspect-square w-full overflow-hidden">
                {art.type === 'video' ? (
                  <video 
                    src={art.src} 
                    autoplay 
                    loop 
                    muted 
                    playsinline
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  />
                ) : (
                  <img 
                    src={art.src} 
                    alt={title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform" 
                  />
                )}
              </div>

              <div class="p-1.5">

                <!-- Название -->
                <span class="text-lg md:text-base text-primary font-semibold">{title}</span>
    
                <div class="flex flex-wrap gap-1 mt-1">
                  {art.tags.slice(0, 2).map(tag => (
                    <!-- Теги -->
                    <span class="bg-brand-light/50 px-1 py-0.5 rounded-full text-lg text-brand-white">
                      {tag}
                    </span>
                  ))}
                  {art.tags.length > 5 && (
                    <span class="text-xs text-brand-white/50">+{art.tags.length - 2}</span>
                  )}
                </div>
                
                <!-- Описание -->
                <h3 class="font-semibold text-xs md:text-lg mt-1 text-brand-white line-clamp-2">{description}</h3>
              </div>

            </div>
	    </a>
	  );
	})}
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('#filter-tags .filter-btn');
      const artworkCards = document.querySelectorAll('#artworks-container .artwork-card');
      
      let activeTag = 'all';

      function updateFilter(tag) {
        if (tag === 'all') {
          artworkCards.forEach(card => {
            card.style.display = '';
          });
        } else {
          artworkCards.forEach(card => {
            const cardTags = card.getAttribute('data-tags').split(',');
            if (cardTags.includes(tag)) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        }
        
        filterBtns.forEach(btn => {
          const btnTag = btn.getAttribute('data-tag');
          if (btnTag === tag) {
            btn.classList.remove('bg-brand-light');
            btn.classList.add('bg-primary');
          } else {
            btn.classList.remove('bg-primary');
            btn.classList.add('bg-brand-light');
          }
        });
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-tag');
          
          if (activeTag === tag) {
            activeTag = 'all';
            updateFilter('all');
          } else {
            activeTag = tag;
            updateFilter(tag);
          }
        });
      });
    });
  </script>
</BaseLayout>