---
// src/pages/[lang]/art.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;

const artworks = [
  { 
    titleEn: 'Girl', 
    titleRu: 'Девочка', 
    categoryEn: 'Concept', 
    categoryRu: 'Концепт', 
    src: `${base}videos/Girl.webp`
  },
  { 
    titleEn: 'Unicorn', 
    titleRu: 'Единорог', 
    categoryEn: 'Character', 
    categoryRu: 'Персонаж', 
    src: `${base}images/unicorn.jpg`
  },
];

const getArtworkData = (art: typeof artworks[0]) => {
  const title = currentLang === 'en' ? art.titleEn : art.titleRu;
  const category = currentLang === 'en' ? art.categoryEn : art.categoryRu;
  return { title, category };
};
---

<BaseLayout title={t('art.title', currentLang)}>
  <div class="mt-6">

    <h1 class="text-4xl md:text-5xl font-bold mb-2 text-brand-white">
      {t('art.title', currentLang)}
    </h1>

    <p class="text-primary mb-12 text-2xl">
      {t('art.subtitle', currentLang)}
    </p>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {artworks.map(art => {
        const { title, category } = getArtworkData(art);
        return (
          <div class="group cursor-pointer">
            <div class="bg-brand-dark rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all">
              <img src={art.src} alt={title} class="w-full h-64 object-cover group-hover:scale-105 transition-transform" />
              <div class="p-4">
                <span class="text-4xl text-primary font-semibold">{category}</span>
                <h3 class="font-semibold text-2xl mt-1 text-brand-white">{title}</h3>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</BaseLayout>