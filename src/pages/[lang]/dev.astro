---
// src/pages/[lang]/dev.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { Icon } from 'astro-icon/components';
import { projects } from '../../data/projects';
import ProjectLinks from '../../components/ProjectLinks.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const buttonClass = "min-w-[160px] md:min-w-[220px] whitespace-nowrap md:whitespace-nowrap text-brand-white px-6 py-3 rounded-xl text-xl md:text-2xl font-semibold transition-all flex items-center justify-center gap-2";

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;

const allTechs = ['2D', 'Jam'];

const getProjectData = (project: typeof projects[0]) => {
  const description = currentLang === 'en' ? project.descriptionEn : project.descriptionRu;
  const about = currentLang === 'en' ? project.aboutEn : project.aboutRu;
  return { description, about };
};
---

<BaseLayout title={t('dev.title', currentLang)}>
  <div class="mt-6">

    <h1 class="text-4xl md:text-8xl font-bold mb-12 text-brand-white">
      {t('dev.title', currentLang)}
    </h1>

    <p class="text-primary mb-12 text-2xl md:text-3xl">
      {t('dev.subtitle', currentLang)}
    </p>


    <!-- Социальные ссылки -->
<div class="flex flex-wrap justify-center gap-4 mb-12">
    
  <a href="https://arcashh.itch.io/" target="_blank" rel="noopener noreferrer" 
     class="bg-brand-dark hover:bg-primary text-brand-white px-6 py-3 rounded-xl transition-all flex items-center gap-2">
    <Icon name="simple-icons:itchdotio" class="w-6 h-6" />
    Itch.io
  </a>
  
  <!--
  {currentLang === 'en' && (
  <a href="https://gamejolt.com/@ArcasHH" target="_blank" rel="noopener noreferrer" 
     class="bg-brand-dark hover:bg-primary text-brand-white px-6 py-3 rounded-xl transition-all flex items-center gap-2">
    <img 
        src={`${base}images/icons/logo_gamejolt.svg`} 
        alt="GameJolt" 
        class="w-6 h-6" 
    />
    GameJolt
  </a>
)}
-->

  {currentLang === 'ru' && (
    <a href="https://myindie.ru/users/user/arcashh" target="_blank" rel="noopener noreferrer" 
       class="bg-brand-dark hover:bg-primary text-brand-white px-6 py-3 rounded-xl transition-all flex items-center gap-2">
      <img 
          src={`${base}images/icons/logo_myindie.svg`} 
          alt="MyIndie" 
          class="w-6 h-6" 
      />
      MyIndie
    </a>
  )}

 </div>
 
 


    <!-- Фильтр технологий -->
    <div class="mb-10 flex flex-wrap items-center gap-4">
      <p class="text-brand-white text-2xl md:text-3xl font-semibold">
        {currentLang === 'ru' ? 'Фильтр:' : 'Filter:'}
      </p>
      <div class="flex flex-wrap gap-3" id="filter-buttons">
        <button 
          id="filter-all"
          class="filter-btn px-5 py-2 rounded-full bg-primary text-brand-white text-lg md:text-xl transition-all"
          data-tech="all"
        >
          {currentLang === 'ru' ? 'Все' : 'All'}
        </button>
        {allTechs.map(tech => (
          <button 
            key={tech}
            class="filter-btn px-5 py-2 rounded-full bg-brand-light hover:bg-primary text-brand-white text-lg md:text-xl transition-all"
            data-tech={tech}
          >
            {tech}
          </button>
        ))}
      </div>
    </div>

    <!-- Контейнер проектов -->
    <div id="projects-container" class="grid gap-10">
      {projects.map(project => {
        const { description, about } = getProjectData(project);
        return (
          <div 
            class="project-card bg-brand-dark rounded-2xl shadow-md hover:shadow-xl transition-all p-6" 
            data-tech={project.tech.join(',')}
          >
            <div class="flex flex-col md:flex-row gap-6">
          
              {project.gifUrl && (
                <div class="md:w-1/5">
                  <img src={project.gifUrl} alt={project.title} class="rounded-4xl w-full" />
                </div>
              )}

              <div class="md:w-3/5 lg:w-3/5">
                <h2 class="text-4xl font-semibold text-brand-white">
                  {project.title}
                </h2>

                <div class="flex flex-wrap gap-2 mt-2">
                  {project.tech.map(techItem => (
                    <span class="bg-brand-light px-3 py-1 rounded-full text-lg md:text-xl text-brand-white">{techItem}</span>
                  ))}
                </div>

                <p class="mt-3 text-2xl md:text-4xl text-brand-white">
                  {description}
                </p>

                <p class="mt-3 text-xl md:text-2xl text-brand-light">
                  {about}
                </p>
              </div>

              
              <div class="md:w-1/5 flex flex-col items-stretch gap-3 ml-auto md:ml-4">
                 <ProjectLinks slug={project.slug} direction="col" showBlog={true}/>
              </div>

            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('#filter-buttons .filter-btn');
      const projectCards = document.querySelectorAll('#projects-container .project-card');
      
      let activeTech = 'all';

      function updateFilter(tech) {
        // Фильтруем проекты
        if (tech === 'all') {
          projectCards.forEach(card => {
            card.style.display = '';
          });
        } else {
          projectCards.forEach(card => {
            const cardTechs = card.getAttribute('data-tech').split(',');
            if (cardTechs.includes(tech)) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        }
        
        // Обновляем стили кнопок
        filterBtns.forEach(btn => {
          const btnTech = btn.getAttribute('data-tech');
          if (btnTech === tech) {
            btn.classList.remove('bg-brand-light');
            btn.classList.add('bg-primary');
          } else {
            btn.classList.remove('bg-primary');
            btn.classList.add('bg-brand-light');
          }
        });
      }

      // Добавляем обработчики на кнопки
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tech = btn.getAttribute('data-tech');
          
          // Если нажата уже активная кнопка - сбрасываем фильтр
          if (activeTech === tech) {
            activeTech = 'all';
            updateFilter('all');
          } else {
            activeTech = tech;
            updateFilter(tech);
          }
        });
      });
    });
  </script>
</BaseLayout>