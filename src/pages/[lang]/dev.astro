---
// src/pages/[lang]/dev.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang;
const base = import.meta.env.BASE_URL;

const projects = [
  {
    title: 'AceAge',
    techEn: ['Deck Building', 'Strategy'],
    techRu: ['Deck Building', 'Strategy'],
    descriptionEn: 'Forge your deck. Conquer the wilds',
    descriptionRu: 'Собери свою колоду. Покори дикие земли',
    gifUrl: `${base}images/AceAge.png`,
    github: '',
    demo: 'https://clinicallysleepy.itch.io/ace-age'
  },
  {
    title: 'Shadow Fox',
    techEn: ['Godot', 'GDScript', 'Pixel Art'],
    techRu: ['Godot', 'GDScript', 'Пиксель-арт'],
    descriptionEn: 'Physics, frame-by-frame animation, custom level editor',
    descriptionRu: 'Физика, покадровая анимация, кастомный редактор уровней',
    gifUrl: `${base}images/shadowfox.gif`,
    github: '',
    demo: null
  }
];

const getProjectData = (project: typeof projects[0]) => {
  const tech = currentLang === 'en' ? project.techEn : project.techRu;
  const description = currentLang === 'en' ? project.descriptionEn : project.descriptionRu;
  return { tech, description };
};
---

<BaseLayout title={t('dev.title', currentLang)}>
  <div class="mt-6">

    <h1 class="text-4xl md:text-5xl font-bold mb-2 text-brand-white">
      {t('dev.title', currentLang)}
    </h1>

    <p class="text-primary mb-12 text-2xl">
      {t('dev.subtitle', currentLang)}
    </p>
    
    <div class="grid gap-10">
      {projects.map(project => {
        const { tech, description } = getProjectData(project);
        return (
          <div class="bg-brand-dark rounded-2xl shadow-md hover:shadow-xl transition-all p-6">
            <div class="flex flex-col md:flex-row gap-6">
              {project.gifUrl && (
                <div class="md:w-1/3">
                  <img src={project.gifUrl} alt={project.title} class="rounded-4xl w-full" />
                </div>
              )}
              <div class="md:w-2/3">

                <h2 class="text-4xl font-semibold text-brand-white">
		  {project.title}
		</h2>

                <div class="flex flex-wrap gap-2 mt-2">
                  {tech.map(techItem => (
                    <span class="bg-brand-light px-3 py-1 rounded-full text-sm text-brand-white">{techItem}</span>
                  ))}
                </div>

                <p class="mt-3 text-brand-white/80">
		  {description}
		</p>

                <div class="mt-5 flex gap-4">
                  {project.github && <a href={project.github} class="text-primary hover:underline">{t('dev.github', currentLang)}</a>}
                  {project.demo && <a href={project.demo} class="text-primary hover:underline">{t('dev.demo', currentLang)}</a>}
                </div>

              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>