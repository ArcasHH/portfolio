---
// src/components/Nav.astro
import { t, getLocalizedUrl } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const currentLang = currentPath.includes('/en/') ? 'en' : 'ru';

---

<nav class="mb-4 bg-brand-dark rounded-xl">
  <div class="relative flex items-center md:items-center justify-around md:justify-center py-4 md:py-6 px-4 gap-4 md:gap-0">
    
    <ul class="flex flex-col md:flex-row items-center gap-4 md:gap-12 justify-center md:justify-center text-2xl md:text-4xl flex-1">
        <a 
          href={getLocalizedUrl('/', currentLang, base)} 
          class="hover:text-primary transition-colors text-brand-white whitespace-nowrap {currentPath.endsWith('/ru/') || currentPath.endsWith('/en/') ? 'font-bold' : ''}"
        >
          {t('nav.home', currentLang)}
        </a>

        <a 
          href={getLocalizedUrl('/dev', currentLang, base)} 
          class="hover:text-primary transition-colors text-brand-white whitespace-nowrap {currentPath.includes('/dev') ? 'font-bold' : ''}"
        >
          {t('nav.games', currentLang)}
        </a>

        <a 
          href={getLocalizedUrl('/art', currentLang, base)} 
          class="hover:text-primary transition-colors text-brand-white whitespace-nowrap {currentPath.includes('/art') ? 'font-bold' : ''}"
        >
          {t('nav.art', currentLang)}
        </a>
<!--
        <a 
          href={getLocalizedUrl('/about', currentLang, base)} 
          class="hover:text-primary transition-colors text-brand-white whitespace-nowrap {currentPath.includes('/about') ? 'font-bold' : ''}"
        >
          {t('nav.contacts', currentLang)}
        </a>
-->
    </ul>

    <div class="flex justify-end ml-auto md:absolute md:right-4">
      <LanguageSwitcher currentLang={currentLang} />
    </div>

  </div>
</nav>